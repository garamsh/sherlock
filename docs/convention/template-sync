# Template sync record
#
# Why this repository differs from `template/main` where it does. Read by a
# person; no tool parses it.
#
# THE CHECK IS A DERIVATION, NOT THIS FILE:
#
#   for f in docs/convention/*.md; do
#     git diff --numstat HEAD template/main -- "$f"
#   done
#
# Every file that comes back differing is either named in `skipped` below with
# the decision that owns it, or has not been considered. That is the whole
# protocol, and it reads what is true now rather than what was true when
# somebody last wrote a line here.
#
# `last-audited` below is a bookmark and nothing verifies it. It is a
# convenience for narrowing `git log`, not the check: if it goes stale the
# derivation still gives the right answer, and a reader who trusts it instead
# of running the derivation gets the older one.

last-audited: d796d58

# What that revision covers. This record begins at 65e0087 and does not claim the
# history below it was examined commit by commit — it was adopted without a
# record of what it skipped. A sync that reaches further back re-establishes
# that rather than reading coverage into this line.
audited-paths:
  docs/convention/README.md
  docs/convention/documentation.md
  docs/convention/review.md

# Differing and NOT yet audited. The derivation reports these; nothing here
# explains them, which is what "not considered" looks like.
unaudited:
  docs/convention/ci.md — 25 lines differ and they are mixed: entry-point
    bullets this project kept where upstream moved to a code block, and
    rewordings upstream made that were never weighed here. Separating the two
    is an audit rather than a record change.

# Never synced, by the sync-conventions skill's own Update table, which places
# these on the project's side rather than the template's. A change here is a
# decision this repository makes, not a hunk it adopts.
project-owned:
  docs/convention/stack-go.md
  docs/architecture/
  README.md

# Deliberate divergences in the files that ARE synced. Each names the decision
# that owns it, so a later sync re-proposes nothing already settled.
