{
	"name": "file_list",
	"description": "List the entries of a directory inside the agent's workspace.",
	"command": "file_list",
	"input_schema": {
		"type": "object",
		"properties": {
			"path": {
				"type": "string",
				"minLength": 1
			}
		},
		"required": [
			"path"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"entries": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string"
						},
						"dir": {
							"type": "boolean"
						}
					},
					"required": [
						"name",
						"dir"
					],
					"additionalProperties": false
				}
			}
		},
		"required": [
			"entries"
		],
		"additionalProperties": false
	}
}
