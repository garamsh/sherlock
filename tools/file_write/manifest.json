{
	"name": "file_write",
	"description": "Create or replace a file inside the agent's workspace with the supplied content. Empty content creates or truncates an empty file.",
	"command": "file_write",
	"input_schema": {
		"type": "object",
		"properties": {
			"path": {
				"type": "string",
				"minLength": 1
			},
			"content": {
				"type": "string"
			}
		},
		"required": [
			"path",
			"content"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"bytes_written": {
				"type": "integer"
			}
		},
		"required": [
			"bytes_written"
		],
		"additionalProperties": false
	}
}
