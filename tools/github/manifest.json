{
	"name": "github",
	"description": "Open issues and add comments on GitHub. Repository checkout, testing, commits and pull requests use ordinary git/gh commands through shell_exec in an operator-provisioned workspace.",
	"command": "github",
	"input_schema": {
		"type": "object",
		"properties": {
			"operation": {
				"type": "string",
				"enum": [
					"open_issue",
					"comment"
				]
			},
			"owner": {
				"type": "string",
				"minLength": 1
			},
			"repo": {
				"type": "string",
				"minLength": 1
			},
			"title": {
				"type": "string",
				"minLength": 1
			},
			"body": {
				"type": "string"
			},
			"labels": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"number": {
				"type": "integer",
				"minimum": 1
			},
			"message": {
				"type": "string",
				"minLength": 1
			}
		},
		"required": [
			"operation",
			"owner",
			"repo"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"status": {
				"type": "string"
			},
			"url": {
				"type": "string"
			},
			"number": {
				"type": "integer"
			},
			"id": {
				"type": "integer"
			}
		},
		"required": [
			"status"
		],
		"additionalProperties": false
	}
}
