{
	"name": "github",
	"description": "Push branches and manage issues, pull requests, and comments on GitHub via the REST API.",
	"command": "github",
	"input_schema": {
		"type": "object",
		"properties": {
			"operation": {"type": "string", "enum": ["push", "open_issue", "open_pull_request", "comment"]},
			"owner": {"type": "string", "minLength": 1},
			"repo": {"type": "string", "minLength": 1},
			"branch": {"type": "string", "minLength": 1},
			"sha": {"type": "string", "minLength": 1},
			"title": {"type": "string", "minLength": 1},
			"body": {"type": "string"},
			"labels": {"type": "array", "items": {"type": "string"}},
			"head": {"type": "string", "minLength": 1},
			"base": {"type": "string", "minLength": 1},
			"number": {"type": "integer", "minimum": 1},
			"message": {"type": "string", "minLength": 1}
		},
		"required": ["operation", "owner", "repo"],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"status": {"type": "string"},
			"url": {"type": "string"},
			"number": {"type": "integer"},
			"id": {"type": "integer"}
		},
		"required": ["status"],
		"additionalProperties": false
	}
}
