{
	"name": "github_comment",
	"description": "Comment on a GitHub issue or pull request, by its number, via the REST API.",
	"command": "github_comment",
	"input_schema": {
		"type": "object",
		"properties": {
			"owner": {
				"type": "string",
				"minLength": 1
			},
			"repo": {
				"type": "string",
				"minLength": 1
			},
			"number": {
				"type": "integer",
				"minimum": 1
			},
			"message": {
				"type": "string",
				"minLength": 1
			}
		},
		"required": [
			"owner",
			"repo",
			"number",
			"message"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"status": {
				"type": "string"
			},
			"url": {
				"type": "string"
			},
			"id": {
				"type": "integer"
			}
		},
		"required": [
			"status",
			"url",
			"id"
		],
		"additionalProperties": false
	}
}
