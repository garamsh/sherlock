{
	"name": "github_open_issue",
	"description": "Open an issue on a GitHub repository via the REST API. body may be empty; labels may be an empty list.",
	"command": "github_open_issue",
	"input_schema": {
		"type": "object",
		"properties": {
			"owner": {
				"type": "string",
				"minLength": 1
			},
			"repo": {
				"type": "string",
				"minLength": 1
			},
			"title": {
				"type": "string",
				"minLength": 1
			},
			"body": {
				"type": "string"
			},
			"labels": {
				"type": "array",
				"items": {
					"type": "string"
				}
			}
		},
		"required": [
			"owner",
			"repo",
			"title",
			"body",
			"labels"
		],
		"additionalProperties": false
	},
	"output_schema": {
		"type": "object",
		"properties": {
			"status": {
				"type": "string"
			},
			"url": {
				"type": "string"
			},
			"number": {
				"type": "integer"
			}
		},
		"required": [
			"status",
			"url",
			"number"
		],
		"additionalProperties": false
	}
}
