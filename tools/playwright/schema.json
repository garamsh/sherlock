{
	"input": {
		"type": "object",
		"properties": {
			"url": {"type": "string", "format": "uri"},
			"action": {"type": "string", "enum": ["navigate", "extract_text", "click", "fill_form"]},
			"selector": {"type": "string"},
			"text": {"type": "string"},
			"timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
		},
		"required": ["url", "action"],
		"additionalProperties": false
	},
	"output": {
		"type": "object",
		"properties": {
			"ok": {"type": "boolean"},
			"body": {"type": ["string", "null"]},
			"extracted_text": {"type": ["string", "null"]},
			"error": {"type": ["string", "null"]}
		},
		"required": ["ok", "body", "extracted_text", "error"],
		"additionalProperties": false
	}
}
